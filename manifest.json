{
    "manifest_version": 3,
    "name": "BIUU Wallet",
    "version": "0.0.1",
    "description": "Chrome 插件",
    "icons": {
        "16": "icons/icon.png",
        "19": "icons/icon.png",
        "38": "icons/icon.png",
        "48": "icons/icon.png",
        "128": "icons/icon.png"
    },
    "action": {
        "default_title": "BIUU Wallet",
        "default_icon": "icons/icon.png",
        "default_popup": "popup/index.html"
    },
    "background": {
        "service_worker": "background/service-worker.js",
        "type": "module"
    },
    "permissions": ["scripting", "activeTab", "tabs", "alarms", "storage", "notifications"],
    "host_permissions": ["<all_urls>"],
    "content_scripts": [
        {
            "js": ["content/content.js"],
            "matches": ["<all_urls>"],
            "all_frames": true,
            "run_at": "document_start",
            "match_about_blank": true
        }
    ],
    "web_accessible_resources": [
        {
            "resources": ["popup/*", "content/content.js", "contentPage/*", "assets/*", "js/*", "injected/*"],
            "matches": ["<all_urls>"]
        }
    ]
}
